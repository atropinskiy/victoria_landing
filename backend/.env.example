# PostgreSQL — контейнер db из docker-compose.yml (докер сам поднимает базу для локальной разработки)
DB_HOST=db
DB_PORT=5432
DB_NAME=victoria
DB_USER=victoria
DB_PASSWORD=victoria

# Ключи для подписи JWT (ES256) — сгенерировать через:
#   python scripts/generate_jwt_keys.py
# и вставить вывод сюда как есть (многострочный PEM в кавычках).
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ALGORITHM=ES256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
